PORT=3000
LOCAL_ANALYTICS_MODE=true
DATA_BORROWERS=10000
DATA_MONTHS=36
DATA_SEED=42
SESSION_TIMEOUT_MINUTES=30
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
MFA_MAX_ATTEMPTS=5
AUDIT_MAX_EVENTS=10000
# Optional initial admin provision. If omitted, use the one-time token printed at first startup.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional externally generated first-admin token; never commit the value.
AUTH_BOOTSTRAP_TOKEN=
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
EXASOL_DSN=

# Supplemental synthetic NPA coverage (base borrower generator remains unchanged)
NPA_DEMO_ENABLED=true
NPA_DEMO_SCENARIOS=12
